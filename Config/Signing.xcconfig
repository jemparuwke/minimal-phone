// ─────────────────────────────────────────────────────────────
//  Minimal — podpisywanie aplikacji
//
//  Najprościej: w Xcode wybierz swój zespół (Team) w karcie
//  Signing & Capabilities targetów Minimal i MinimalWidget.
//  Identyfikatory aplikacji utworzą się same z Twojego Team ID.
//
//  Zamiast tego możesz utworzyć plik Config/Signing.local.xcconfig
//  (nie trafia do gita) i wpisać w nim np.:
//
//      DEVELOPMENT_TEAM = ABCDE12345
//      MINIMAL_EDITION = Free
//
//  MINIMAL_EDITION:
//     Full — płatne konto Apple Developer (99 USD/rok): pełna tarcza
//            (filtr Apple, filtr DNS, blokada aplikacji).
//     Free — darmowe konto Apple: wszystko poza automatyczną tarczą;
//            zamiast niej profil DNS i wbudowany filtr iOS (przewodnik
//            w aplikacji). Aplikację trzeba odświeżać co 7 dni.
// ─────────────────────────────────────────────────────────────

DEVELOPMENT_TEAM =
MINIMAL_EDITION = Full

// Unikalny prefiks identyfikatorów — domyślnie oparty na Team ID.
BUNDLE_ID_PREFIX = pl.minimal.$(DEVELOPMENT_TEAM)

#include? "Signing.local.xcconfig"

// Nie zmieniaj poniższych linii.
APP_BUNDLE_ID = $(BUNDLE_ID_PREFIX).minimal
WIDGET_BUNDLE_ID = $(APP_BUNDLE_ID).widget
APP_GROUP_ID = group.$(APP_BUNDLE_ID)
